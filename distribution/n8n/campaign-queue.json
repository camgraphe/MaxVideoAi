{
  "name": "MaxVideoAI - Bounded campaign queue",
  "active": false,
  "nodes": [
    { "id": "campaign-trigger", "name": "Approved Brief List", "type": "n8n-nodes-base.manualTrigger", "typeVersion": 1, "position": [-900, 0], "parameters": {} },
    { "id": "campaign-limit", "name": "Limit Campaign Items", "type": "n8n-nodes-base.limit", "typeVersion": 1, "position": [-680, 0], "parameters": { "maxItems": 20, "keep": "firstItems" } },
    { "id": "campaign-loop", "name": "Bounded Campaign Loop", "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [-460, 0], "parameters": { "batchSize": 1, "options": {} } },
    { "id": "campaign-normalize", "name": "Normalize Campaign Item", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [-240, 0], "parameters": { "mode": "manual", "assignments": { "assignments": [{ "id": "brief-id", "name": "briefId", "type": "string", "value": "={{ $json.briefId }}" }, { "id": "budget-request", "name": "projectBudgetRequest", "type": "object", "value": "={{ $json.projectBudgetRequest }}" }, { "id": "generation-request", "name": "generationRequest", "type": "object", "value": "={{ $json.generationRequest }}" }] } } },
    { "id": "campaign-budget", "name": "Calculate Project Budget", "type": "@n8n/n8n-nodes-langchain.mcpClient", "typeVersion": 1, "position": [-20, 0], "parameters": { "serverTransport": "httpStreamable", "endpointUrl": "https://api.maxvideoai.com/mcp", "authentication": "mcpOAuth2Api", "tool": { "mode": "list", "value": "calculate_project_budget" }, "inputMode": "json", "jsonInput": "={{ JSON.stringify($('Normalize Campaign Item').item.json.projectBudgetRequest) }}" } },
    { "id": "campaign-prepare", "name": "Prepare Generation", "type": "@n8n/n8n-nodes-langchain.mcpClient", "typeVersion": 1, "position": [200, 0], "parameters": { "serverTransport": "httpStreamable", "endpointUrl": "https://api.maxvideoai.com/mcp", "authentication": "mcpOAuth2Api", "tool": { "mode": "list", "value": "prepare_generation" }, "inputMode": "json", "jsonInput": "={{ JSON.stringify($('Normalize Campaign Item').item.json.generationRequest) }}" } },
    { "id": "campaign-approval", "name": "Human Approval", "type": "n8n-nodes-base.wait", "typeVersion": 1.1, "position": [420, 0], "parameters": { "resume": "webhook", "httpMethod": "POST", "amount": 1, "unit": "days", "approvalRule": "one approval per item for the exact fresh quote" } },
    { "id": "campaign-approval-check", "name": "Require Explicit Approval", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [640, 0], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 }, "conditions": [{ "id": "exact-approval", "leftValue": "={{ $json.body && $json.body.approved === true && $json.body.quoteId === $('Prepare Generation').item.json.structuredContent.quoteId }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }], "combinator": "and" } } },
    { "id": "campaign-rejected", "name": "Approval Rejected", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [860, 160], "parameters": { "outcome": "No generation was confirmed for this item" } },
    { "id": "campaign-confirm", "name": "Confirm Generation", "type": "@n8n/n8n-nodes-langchain.mcpClient", "typeVersion": 1, "position": [860, -40], "parameters": { "serverTransport": "httpStreamable", "endpointUrl": "https://api.maxvideoai.com/mcp", "authentication": "mcpOAuth2Api", "tool": { "mode": "list", "value": "confirm_generation" }, "inputMode": "json", "jsonInput": "={{ JSON.stringify({ quoteId: $('Prepare Generation').item.json.structuredContent.quoteId, confirmed: true }) }}" } },
    { "id": "campaign-wait", "name": "Wait Before Status", "type": "n8n-nodes-base.wait", "typeVersion": 1.1, "position": [1080, -40], "parameters": { "resume": "timeInterval", "amount": 15, "unit": "seconds" } },
    { "id": "campaign-status", "name": "Get Generation Status", "type": "@n8n/n8n-nodes-langchain.mcpClient", "typeVersion": 1, "position": [1300, -40], "parameters": { "serverTransport": "httpStreamable", "endpointUrl": "https://api.maxvideoai.com/mcp", "authentication": "mcpOAuth2Api", "tool": { "mode": "list", "value": "get_generation_status" }, "inputMode": "json", "jsonInput": "={{ JSON.stringify({ jobId: $('Confirm Generation').item.json.structuredContent.jobId }) }}" } },
    { "id": "campaign-terminal", "name": "Generation Terminal?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [1520, -40], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 }, "conditions": [{ "id": "completed", "leftValue": "={{ $json.structuredContent.status }}", "rightValue": "completed", "operator": { "type": "string", "operation": "equals" } }, { "id": "failed", "leftValue": "={{ $json.structuredContent.status }}", "rightValue": "failed", "operator": { "type": "string", "operation": "equals" } }], "combinator": "or" } } },
    { "id": "campaign-poll-limit", "name": "Continue Polling?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [1740, 80], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 }, "conditions": [{ "id": "bounded-poll", "leftValue": "={{ $runIndex < 19 }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true" } }], "combinator": "and" } } },
    { "id": "campaign-poll-timeout", "name": "Polling Timed Out", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [1960, 160], "parameters": { "outcome": "Accepted job remains recoverable by jobId" } },
    { "id": "campaign-result", "name": "Present Result", "type": "@n8n/n8n-nodes-langchain.mcpClient", "typeVersion": 1, "position": [1740, -120], "parameters": { "serverTransport": "httpStreamable", "endpointUrl": "https://api.maxvideoai.com/mcp", "authentication": "mcpOAuth2Api", "tool": { "mode": "list", "value": "present_generation" }, "inputMode": "json", "jsonInput": "={{ JSON.stringify({ jobId: $('Confirm Generation').item.json.structuredContent.jobId }) }}" } }
  ],
  "connections": {
    "Approved Brief List": { "main": [[{ "node": "Limit Campaign Items", "type": "main", "index": 0 }]] },
    "Limit Campaign Items": { "main": [[{ "node": "Bounded Campaign Loop", "type": "main", "index": 0 }]] },
    "Bounded Campaign Loop": { "main": [[], [{ "node": "Normalize Campaign Item", "type": "main", "index": 0 }]] },
    "Normalize Campaign Item": { "main": [[{ "node": "Calculate Project Budget", "type": "main", "index": 0 }]] },
    "Calculate Project Budget": { "main": [[{ "node": "Prepare Generation", "type": "main", "index": 0 }]] },
    "Prepare Generation": { "main": [[{ "node": "Human Approval", "type": "main", "index": 0 }]] },
    "Human Approval": { "main": [[{ "node": "Require Explicit Approval", "type": "main", "index": 0 }]] },
    "Require Explicit Approval": { "main": [[{ "node": "Confirm Generation", "type": "main", "index": 0 }], [{ "node": "Approval Rejected", "type": "main", "index": 0 }]] },
    "Approval Rejected": { "main": [[{ "node": "Bounded Campaign Loop", "type": "main", "index": 0 }]] },
    "Confirm Generation": { "main": [[{ "node": "Wait Before Status", "type": "main", "index": 0 }]] },
    "Wait Before Status": { "main": [[{ "node": "Get Generation Status", "type": "main", "index": 0 }]] },
    "Get Generation Status": { "main": [[{ "node": "Generation Terminal?", "type": "main", "index": 0 }]] },
    "Generation Terminal?": { "main": [[{ "node": "Present Result", "type": "main", "index": 0 }], [{ "node": "Continue Polling?", "type": "main", "index": 0 }]] },
    "Continue Polling?": { "main": [[{ "node": "Wait Before Status", "type": "main", "index": 0 }], [{ "node": "Polling Timed Out", "type": "main", "index": 0 }]] },
    "Polling Timed Out": { "main": [[{ "node": "Bounded Campaign Loop", "type": "main", "index": 0 }]] },
    "Present Result": { "main": [[{ "node": "Bounded Campaign Loop", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveDataErrorExecution": "all", "saveDataSuccessExecution": "none" },
  "tags": []
}
