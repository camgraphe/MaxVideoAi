{
  "name": "MaxVideoAI - Bounded campaign queue",
  "active": false,
  "nodes": [
    { "id": "campaign-trigger", "name": "Approved Brief List", "type": "n8n-nodes-base.manualTrigger", "typeVersion": 1, "position": [-900, 0], "parameters": {} },
    { "id": "campaign-loop", "name": "Bounded Campaign Loop", "type": "n8n-nodes-base.splitInBatches", "typeVersion": 3, "position": [-680, 0], "parameters": { "batchSize": 1, "maxItems": 20, "approvalPolicy": "one approval per item" } },
    { "id": "campaign-key", "name": "Stable Item Key", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [-460, 0], "parameters": { "mode": "manual", "assignments": { "assignments": [{ "id": "idempotency", "name": "idempotencyKey", "type": "string", "value": "={{ $execution.id + '-' + $itemIndex + '-' + $json.briefId }}" }] } } },
    { "id": "campaign-budget", "name": "Calculate Project Budget", "type": "n8n-nodes-langchain.mcpClient", "typeVersion": 1, "position": [-240, 0], "parameters": { "serverTransport": "httpStreamable", "endpointUrl": "https://api.maxvideoai.com/mcp", "authentication": "oAuth2", "tool": "calculate_project_budget", "inputMode": "json", "jsonInput": "={{ JSON.stringify($json.projectProposal) }}" } },
    { "id": "campaign-prepare", "name": "Prepare Generation", "type": "n8n-nodes-langchain.mcpClient", "typeVersion": 1, "position": [-20, 0], "parameters": { "serverTransport": "httpStreamable", "endpointUrl": "https://api.maxvideoai.com/mcp", "authentication": "oAuth2", "tool": "prepare_generation", "inputMode": "json", "jsonInput": "={{ JSON.stringify({ ...$json.request, idempotencyKey: $('Stable Item Key').item.json.idempotencyKey }) }}" } },
    { "id": "campaign-approval", "name": "Human Approval", "type": "n8n-nodes-base.wait", "typeVersion": 1.1, "position": [200, 0], "parameters": { "resume": "webhook", "amount": 1, "unit": "days", "approvalRule": "one approval per item for the exact fresh quote" } },
    { "id": "campaign-confirm", "name": "Confirm Generation", "type": "n8n-nodes-langchain.mcpClient", "typeVersion": 1, "position": [420, 0], "parameters": { "serverTransport": "httpStreamable", "endpointUrl": "https://api.maxvideoai.com/mcp", "authentication": "oAuth2", "tool": "confirm_generation", "inputMode": "json", "jsonInput": "={{ JSON.stringify({ quoteId: $('Prepare Generation').item.json.quoteId, idempotencyKey: $('Stable Item Key').item.json.idempotencyKey, explicitApproval: true }) }}" } },
    { "id": "campaign-wait", "name": "Wait Before Status", "type": "n8n-nodes-base.wait", "typeVersion": 1.1, "position": [640, 0], "parameters": { "resume": "timeInterval", "amount": 15, "unit": "seconds" } },
    { "id": "campaign-status", "name": "Get Generation Status", "type": "n8n-nodes-langchain.mcpClient", "typeVersion": 1, "position": [860, 0], "parameters": { "serverTransport": "httpStreamable", "endpointUrl": "https://api.maxvideoai.com/mcp", "authentication": "oAuth2", "tool": "get_generation_status", "inputMode": "json", "jsonInput": "={{ JSON.stringify({ jobId: $('Confirm Generation').item.json.jobId }) }}" } },
    { "id": "campaign-result", "name": "Present Result", "type": "n8n-nodes-langchain.mcpClient", "typeVersion": 1, "position": [1080, 0], "parameters": { "serverTransport": "httpStreamable", "endpointUrl": "https://api.maxvideoai.com/mcp", "authentication": "oAuth2", "tool": "present_generation", "inputMode": "json", "jsonInput": "={{ JSON.stringify({ jobId: $json.jobId }) }}" } }
  ],
  "connections": {
    "Approved Brief List": { "main": [[{ "node": "Bounded Campaign Loop", "type": "main", "index": 0 }]] },
    "Bounded Campaign Loop": { "main": [[{ "node": "Stable Item Key", "type": "main", "index": 0 }], []] },
    "Stable Item Key": { "main": [[{ "node": "Calculate Project Budget", "type": "main", "index": 0 }]] },
    "Calculate Project Budget": { "main": [[{ "node": "Prepare Generation", "type": "main", "index": 0 }]] },
    "Prepare Generation": { "main": [[{ "node": "Human Approval", "type": "main", "index": 0 }]] },
    "Human Approval": { "main": [[{ "node": "Confirm Generation", "type": "main", "index": 0 }]] },
    "Confirm Generation": { "main": [[{ "node": "Wait Before Status", "type": "main", "index": 0 }]] },
    "Wait Before Status": { "main": [[{ "node": "Get Generation Status", "type": "main", "index": 0 }]] },
    "Get Generation Status": { "main": [[{ "node": "Present Result", "type": "main", "index": 0 }]] },
    "Present Result": { "main": [[{ "node": "Bounded Campaign Loop", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveDataErrorExecution": "all", "saveDataSuccessExecution": "none" },
  "tags": []
}
