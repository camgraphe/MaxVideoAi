  "findings": [
    {
      "id": "import-presentation-race",
      "proof": "Chrome Uppy core: two uploadComplete=true and no currentUploads while UI kept one simulating. Deterministic concurrent React/Uppy reproduction red before, green after.",
      "fix": "Single authoritative publish owner; no render-to-ref rollback.",
      "browserRetest": "In-app browser pause, partial delivery and failed-only retry succeeds."
    },
    {
      "id": "mobile-inner-overflow",
      "fix": "Constrain viewer grid column to minmax(0,1fr), bound filmstrip width.",
      "browserRetest": "Complete portrait and close button measured inside 390px."
    },
    {
      "id": "stale-tool-role-ids",
      "proof": {
        "basket": "1Dixie — portrait 0012Motel disco 0013Portrait acidulé 001",
        "status": "Vous pouvez choisir 4 médias pour ce rôle."
      },
      "fix": "Reconcile chosen IDs, saved drafts and incoming handoffs against active media; filter manifests defensively; preserve references hidden only by search.",
      "browserRetest": "Four-slot basket accepts a replacement after preview deletion; saved manifest contains only three remaining valid refs."
    },
    {
      "id": "unrelated-toast-undo",
      "fix": "New notices reset their associated undo payload.",
      "browserRetest": "Collection-success toast has no stale trash Undo."
    },
    {
      "id": "picker-action-label",
      "fix": "Visual and audio picker buttons announce selection; preview remains separate."
    }
  ],
  "limitations": [
    "All metadata in memory; no API, authentication, pagination or private grant renewal",
    "20 repeated transport URLs do not represent 10000 independent media downloads",
    "Single local timings are observational and do not establish production latency or Core Web Vitals gains",
    "Tool handoffs and cloud transfer are simulated; no provider execution",
    "Session state and imports are not durable across reload"
  ],
  "codeReview": {
    "mode": "Independent read-only review and focused recheck",
    "result": "Ready for local user review after all three reported issues were fixed and browser verified",
    "productionAssessment": false
  }
